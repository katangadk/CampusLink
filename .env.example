# Local development. See .env.staging.example for the hosted preview.
# Public/student-launch modes intentionally refuse to start.
CAMPUSLINK_MODE=local
CAMPUSLINK_DB=data/campuslink.sqlite3

# Optional real SMTP delivery for password recovery. Never commit secrets.
# The app does not automatically load .env files; export these in your shell.
# CAMPUSLINK_BASE_URL=http://127.0.0.1:8000
# CAMPUSLINK_SMTP_HOST=
# CAMPUSLINK_SMTP_PORT=587
# CAMPUSLINK_SMTP_FROM=
# CAMPUSLINK_SMTP_USER=
# CAMPUSLINK_SMTP_PASSWORD=
# CAMPUSLINK_SMTP_TLS=starttls
# CAMPUSLINK_MAIL_TOKEN_SECRET=<generate privately, at least 32 characters>
# Local membership approval is optional; enable after granting an operator.
# CAMPUSLINK_REQUIRE_APPROVAL=true
# CAMPUSLINK_SUPPORT_EMAIL=kabundakatanga91@gmail.com
# CAMPUSLINK_OPERATOR_NAME=
# CAMPUSLINK_BACKUPS_ENABLED=true
