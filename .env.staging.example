# Example only. The app does not automatically load .env files.
# Set values in the hosting dashboard. Website access has no shared password.
CAMPUSLINK_MODE=staging
CAMPUSLINK_DB=/var/data/campuslink.sqlite3

# Render supplies RENDER_EXTERNAL_URL automatically. Set this only for another
# host or when using your own canonical HTTPS domain, with no path suffix.
# CAMPUSLINK_BASE_URL=https://your-service.onrender.com

# On Render the launcher trusts its managed ingress. On another host, restrict
# this to your actual reverse proxy IP/network; loopback is the default.
# CAMPUSLINK_TRUSTED_PROXY_IPS=127.0.0.1

# Optional recovery email. Configure these only when delivery can be tested.
# CAMPUSLINK_SMTP_HOST=
# CAMPUSLINK_SMTP_PORT=587
# CAMPUSLINK_SMTP_FROM=
# CAMPUSLINK_SMTP_USER=
# CAMPUSLINK_SMTP_PASSWORD=
