# Example only. The app does not automatically load .env files.
# Set values in the hosting dashboard. Website access has no shared password.
CAMPUSLINK_MODE=staging
CAMPUSLINK_DB=/var/data/campuslink.sqlite3

# Render supplies RENDER_EXTERNAL_URL automatically. Set this only for another
# host or when using your own canonical HTTPS domain, with no path suffix.
# CAMPUSLINK_BASE_URL=https://your-service.onrender.com

# On Render the launcher trusts its managed ingress. On another host, restrict
# this to your actual reverse proxy IP/network; loopback is the default.
# CAMPUSLINK_TRUSTED_PROXY_IPS=127.0.0.1

# Optional recovery email. Configure these only when delivery can be tested.
# CAMPUSLINK_SMTP_HOST=
# CAMPUSLINK_SMTP_PORT=587
# CAMPUSLINK_SMTP_FROM=
# CAMPUSLINK_SMTP_USER=
# CAMPUSLINK_SMTP_PASSWORD=

# Owner controls membership after a trusted staff grant. 'auto' activates
# enforcement at the first operator grant and stays active after revocation.
CAMPUSLINK_REQUIRE_APPROVAL=auto
CAMPUSLINK_ELIGIBILITY_MODE=preview
CAMPUSLINK_SUPPORT_EMAIL=kabundakatanga91@gmail.com
# CAMPUSLINK_OPERATOR_NAME=
# CAMPUSLINK_PRIVACY_REVIEW_DATE=YYYY-MM-DD
# Exact institution domains are optional when the owner reviews each account.
# CAMPUSLINK_STUDENT_EMAIL_DOMAINS=

# Durable confirmation/recovery links: generate a secret in Render, keep it
# outside SQLite and preserve it across deploys. It is NOT a website password.
# CAMPUSLINK_MAIL_TOKEN_SECRET=<generated privately, at least 32 characters>
# CAMPUSLINK_SMTP_TLS=starttls
CAMPUSLINK_BACKUPS_ENABLED=true
CAMPUSLINK_BACKUP_INTERVAL_HOURS=24
CAMPUSLINK_BACKUP_KEEP=3
# CAMPUSLINK_BACKUP_DIR=/var/data/backups
CAMPUSLINK_REGISTRATIONS_PER_HOUR=60

# Optional external student + 18+ checks. Leave disabled until a real account,
# Zambia/university coverage and live programs are confirmed. See OPERATIONS.
CAMPUSLINK_VERIFICATION_LIVE=false
# CAMPUSLINK_VERIFICATION_PROVIDER=sheerid
# CAMPUSLINK_SHEERID_CLIENT_ID=
# CAMPUSLINK_SHEERID_CLIENT_SECRET=
# CAMPUSLINK_SHEERID_WEBHOOK_SECRET=
# CAMPUSLINK_SHEERID_STUDENT_PROGRAM_ID=
# CAMPUSLINK_SHEERID_AGE_PROGRAM_ID=
# CAMPUSLINK_SHEERID_ORGANIZATION_ID=
